@using AuctionOperationsPortal.Components.Layout
@rendermode InteractiveServer
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <section class="auth-required-panel" aria-labelledby="auth-required-title">
                        <span class="eyebrow">Access required</span>
                        <h2 id="auth-required-title">Authentication required</h2>
                        <p>Sign in as a system administrator to continue.</p>
                        <a class="button button-primary" href="/login">Open Operations Portal sign-in</a>
                    </section>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound><p>Sorry, there is nothing at this address.</p></NotFound>
    </Router>
</CascadingAuthenticationState>
