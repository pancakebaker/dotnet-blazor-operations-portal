@page "/login"
@using Microsoft.AspNetCore.Components
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
<PageTitle>System Administration Sign In</PageTitle>
<section class="login-page">
    <div class="login-card">
        <div class="login-card-header">
            <span class="portal-brand-mark" aria-hidden="true">AO</span>
            <span class="eyebrow">System administration</span>
            <h1>Operations Portal</h1>
            <p>Sign in with an authorized system administrator account.</p>
        </div>
        <form class="login-form" method="post" action="/auth/login">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
        <p class="form-field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" required />
        </p>
        <p class="form-field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
        </p>
        <button class="button button-primary" type="submit">Sign in</button>
        </form>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string SafeReturnUrl =>
        ReturnUrl is not null
            && ReturnUrl.StartsWith("/", StringComparison.Ordinal)
            && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            && !ReturnUrl.Contains('\\', StringComparison.Ordinal)
            ? ReturnUrl
            : string.Empty;
}
