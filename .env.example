# Portal-owned PostgreSQL
ConnectionStrings__AuctionOperationsDb=Host=127.0.0.1;Port=55432;Database=auction_operations;Username=auction_app;Password=change_me_in_local_env

# RabbitMQ activity consumer
AUCTION_OPERATIONS_RABBITMQ_HOST=localhost
AUCTION_OPERATIONS_RABBITMQ_PORT=5672
AUCTION_OPERATIONS_RABBITMQ_USERNAME=auction
AUCTION_OPERATIONS_RABBITMQ_PASSWORD=change_me_in_local_env
AUCTION_OPERATIONS_RABBITMQ_VHOST=/

# External service endpoints
BiddingService__BaseUrl=http://localhost:5000
BiddingService__TenantEndpoint=/api/system/tenants
LiveFeedAdmin__BaseUrl=http://localhost:3001
LiveFeedAdmin__SystemTokenEndpoint=/admin/auth/system-token
LiveFeedAdmin__BrowserHandoffEndpoint=/admin/auth/handoff
